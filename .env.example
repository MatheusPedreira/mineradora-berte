# Domínio oficial (sem barra final). Sem ele: sem canonicals, sitemap vazio e noindex.
NEXT_PUBLIC_SITE_URL=
# Libera indexação apenas no lançamento oficial ("true"). Requer NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_INDEXABLE=false
# Google Tag Manager (formato GTM-XXXXXXX). Vazio = nenhum script de análise/publicidade e nenhum aviso de cookies.
# GA4 e Google Ads são configurados dentro do container, não no site. Ver docs/ANALYTICS_SETUP.md.
NEXT_PUBLIC_GTM_ID=
# Opcional: código da meta tag de verificação do Google Search Console (só o valor de "content").
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
